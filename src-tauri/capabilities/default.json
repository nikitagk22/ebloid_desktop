{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Ebloid desktop shell.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "notification:default",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-downloads",
    "allow-cancel-download",
    "allow-reveal-download",
    "allow-clear-download-history",
    "allow-clear-cache",
    "allow-logout-and-clear-cookies",
    "allow-check-for-update",
    "allow-install-update"
  ]
}
