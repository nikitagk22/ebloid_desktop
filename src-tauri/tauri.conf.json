{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ebloid",
  "version": "0.3.1",
  "identifier": "id.eblo.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": ["default", "remote-site"]
    },
    "windows": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ebloid"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/nikitagk22/ebloid_desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzRkI0RjcxODM1NjkwQUIKUldTcmtGYURjVS83TTA3S2ZjNzVxTnkwSzAwTXpSMzZZOFJCOVM5R0tSSmtNOVRpK3E3UmtYTFoK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": ["Russian"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ru-RU"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
