{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ebloid",
  "version": "0.2.0",
  "identifier": "id.eblo.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ebloid"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
